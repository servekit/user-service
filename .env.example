# =============================================================================
# user-service environment configuration
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.example.yaml is listed below. configx uses
# os.ExpandEnv, so an unset var expands to "". Optional sections (captcha,
# rate_limit, cron) are commented out in config.example.yaml — uncomment both
# files together when enabling them.
#
# docker-compose: load via `env_file: .env` and mount config.yaml into
# /etc/user-service/config.yaml (a default configx search path).
#
# NOTE: docker-compose `env_file` does NOT support inline `#` comments — keep
# all comments on their own line (as this file does).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_GRPC=:9000
SERVER_HTTP=:8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL via dbx)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=user_service
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
# silent, error, warn, info
DB_LOG_LEVEL=warn
DB_SLOW_THRESHOLD=200ms
# skip implicit transaction for single ops (recommended for production)
DB_SKIP_DEFAULT_TX=true
# disable foreign key constraints in migration
DB_DISABLE_FK=true
# prefix for all table names; must match migration scripts
DB_TABLE_PREFIX=usr_

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_TTL=168h
# max concurrent sessions per user, 0 = unlimited
SESSION_MAX_SESSIONS=5
SESSION_KEY_PREFIX=user:session
SESSION_USER_SESSIONS_PREFIX=user:user_sessions
# one-time short code TTL for IssueSessionCode (OAuth callback handoff)
SESSION_CODE_TTL=5m

# -----------------------------------------------------------------------------
# RBAC cache TTLs and key prefixes
# -----------------------------------------------------------------------------
RBAC_USER_PERMS_TTL=10m
RBAC_USER_ROLES_TTL=10m
RBAC_ROLE_PERMS_TTL=30m
RBAC_GROUP_ROLES_TTL=30m
RBAC_GROUP_USER_PERMS_TTL=10m
RBAC_USER_PERMS_PREFIX=user:rbac:user_perms
RBAC_USER_ROLES_PREFIX=user:rbac:user_roles
RBAC_ROLE_PERMS_PREFIX=user:rbac:role_perms
RBAC_GROUP_ROLES_PREFIX=user:rbac:group_roles
RBAC_GROUP_USER_PERMS_PREFIX=user:rbac:group_user_perms

# -----------------------------------------------------------------------------
# OAuth providers. Each provider is OPTIONAL — leave credentials empty to
# disable that provider. NEVER enable allow_arbitrary_redirect_urls in prod.
# allowed_redirect_urls is a comma-separated list.
# -----------------------------------------------------------------------------

# GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=https://auth.corp.com/oauth/callback
OAUTH_GITHUB_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
OAUTH_GOOGLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# WeChat
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
OAUTH_WECHAT_REDIRECT_URL=https://auth.corp.com/oauth/callback
OAUTH_WECHAT_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# Apple Sign-In
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# PEM private key; in a single-line .env, paste the PEM with literal \n or
# reference a file path read at startup.
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_APPLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
OAUTH_APPLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
OAUTH_APPLE_CLIENT_SECRET_TTL=30m

# -----------------------------------------------------------------------------
# Third-party — gid-service (snowflake ID generator)
# GID_MODE: module = in-process; grpc = remote gid-service.
# -----------------------------------------------------------------------------
GID_MODE=module
# Only used when GID_MODE=grpc:
GID_TARGET=
# module-mode snowflake config
GID_MACHINE_ID=1
# snowflake epoch — DO NOT change after deployment
GID_START_TIME=2024-01-01T00:00:00Z

# -----------------------------------------------------------------------------
# Third-party — message-service
# MESSAGE_MODE: module = in-process; grpc = remote message-service.
# -----------------------------------------------------------------------------
MESSAGE_MODE=grpc
MESSAGE_TARGET=localhost:9001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
