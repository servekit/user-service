# =============================================================================
# user-service environment configuration
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every ${VAR} referenced in config.example.yaml is listed below. configx uses
# os.ExpandEnv, so an unset var expands to "". Optional sections (captcha,
# rate_limit, cron) are commented out in config.example.yaml — uncomment both
# files together when enabling them.
#
# docker-compose: load via `env_file: .env` and mount config.yaml into
# /etc/user-service/config.yaml (a default configx search path).
#
# NOTE: docker-compose `env_file` does NOT support inline `#` comments — keep
# all comments on their own line (as this file does).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
USER_SERVICE_SERVER_GRPC=:19094
USER_SERVICE_SERVER_HTTP=:18084

# -----------------------------------------------------------------------------
# Database (PostgreSQL via dbx)
# -----------------------------------------------------------------------------
USER_SERVICE_DB_HOST=127.0.0.1
USER_SERVICE_DB_PORT=5432
USER_SERVICE_DB_USER=postgres
USER_SERVICE_DB_PASSWORD=change-me
USER_SERVICE_DB_NAME=user_service
USER_SERVICE_DB_SSLMODE=disable
USER_SERVICE_DB_MAX_OPEN_CONNS=25
USER_SERVICE_DB_MAX_IDLE_CONNS=10
USER_SERVICE_DB_CONN_MAX_LIFETIME=5m
# silent, error, warn, info
USER_SERVICE_DB_LOG_LEVEL=warn
USER_SERVICE_DB_SLOW_THRESHOLD=200ms
# skip implicit transaction for single ops (recommended for production)
USER_SERVICE_DB_SKIP_DEFAULT_TX=true
# disable foreign key constraints in migration
USER_SERVICE_DB_DISABLE_FK=true
# prefix for all table names; must match migration scripts
USER_SERVICE_DB_TABLE_PREFIX=usr_

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
USER_SERVICE_REDIS_ADDR=127.0.0.1:6379
USER_SERVICE_REDIS_PASSWORD=
USER_SERVICE_REDIS_DB=0

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
USER_SERVICE_SESSION_TTL=168h
# max concurrent sessions per user, 0 = unlimited
USER_SERVICE_SESSION_MAX_SESSIONS=5
USER_SERVICE_SESSION_KEY_PREFIX=user:session
USER_SERVICE_SESSION_USER_SESSIONS_PREFIX=user:user_sessions
# one-time short code TTL for IssueSessionCode (OAuth callback handoff)
USER_SERVICE_SESSION_CODE_TTL=5m

# -----------------------------------------------------------------------------
# RBAC cache TTLs and key prefixes
# -----------------------------------------------------------------------------
USER_SERVICE_RBAC_USER_PERMS_TTL=10m
USER_SERVICE_RBAC_USER_ROLES_TTL=10m
USER_SERVICE_RBAC_ROLE_PERMS_TTL=30m
USER_SERVICE_RBAC_GROUP_ROLES_TTL=30m
USER_SERVICE_RBAC_GROUP_USER_PERMS_TTL=10m
USER_SERVICE_RBAC_USER_PERMS_PREFIX=user:rbac:user_perms
USER_SERVICE_RBAC_USER_ROLES_PREFIX=user:rbac:user_roles
USER_SERVICE_RBAC_ROLE_PERMS_PREFIX=user:rbac:role_perms
USER_SERVICE_RBAC_GROUP_ROLES_PREFIX=user:rbac:group_roles
USER_SERVICE_RBAC_GROUP_USER_PERMS_PREFIX=user:rbac:group_user_perms

# -----------------------------------------------------------------------------
# OAuth providers. Each provider is OPTIONAL — leave credentials empty to
# disable that provider. NEVER enable allow_arbitrary_redirect_urls in prod.
# allowed_redirect_urls is a comma-separated list.
# -----------------------------------------------------------------------------

# GitHub
USER_SERVICE_OAUTH_GITHUB_CLIENT_ID=
USER_SERVICE_OAUTH_GITHUB_CLIENT_SECRET=
USER_SERVICE_OAUTH_GITHUB_REDIRECT_URL=https://auth.corp.com/oauth/callback
USER_SERVICE_OAUTH_GITHUB_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# Google
USER_SERVICE_OAUTH_GOOGLE_CLIENT_ID=
USER_SERVICE_OAUTH_GOOGLE_CLIENT_SECRET=
USER_SERVICE_OAUTH_GOOGLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
USER_SERVICE_OAUTH_GOOGLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# WeChat
USER_SERVICE_OAUTH_WECHAT_APP_ID=
USER_SERVICE_OAUTH_WECHAT_APP_SECRET=
USER_SERVICE_OAUTH_WECHAT_REDIRECT_URL=https://auth.corp.com/oauth/callback
USER_SERVICE_OAUTH_WECHAT_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done

# Apple Sign-In
USER_SERVICE_OAUTH_APPLE_CLIENT_ID=
USER_SERVICE_OAUTH_APPLE_TEAM_ID=
USER_SERVICE_OAUTH_APPLE_KEY_ID=
# PEM private key; in a single-line .env, paste the PEM with literal \n or
# reference a file path read at startup.
USER_SERVICE_OAUTH_APPLE_PRIVATE_KEY=
USER_SERVICE_OAUTH_APPLE_REDIRECT_URL=https://auth.corp.com/oauth/callback
USER_SERVICE_OAUTH_APPLE_ALLOWED_REDIRECT_URLS=https://app.corp.com/auth/done,https://admin.corp.com/auth/done
USER_SERVICE_OAUTH_APPLE_CLIENT_SECRET_TTL=30m

# -----------------------------------------------------------------------------
# Captcha (verification codes) — OPTIONAL. Pairs with the commented captcha:
# block in config.example.yaml — uncomment BOTH together to override the
# built-in default. Values below mirror that default (5 codes / 5 min, 3
# attempts, prefix "captcha"). Per-purpose rate rules; the shortest window is
# the code TTL.
# -----------------------------------------------------------------------------
# USER_SERVICE_CAPTCHA_PREFIX=captcha
# USER_SERVICE_CAPTCHA_MAX_ATTEMPTS=3
# USER_SERVICE_CAPTCHA_REGISTER_WINDOW=5m
# USER_SERVICE_CAPTCHA_REGISTER_MAX=5
# USER_SERVICE_CAPTCHA_LOGIN_WINDOW=5m
# USER_SERVICE_CAPTCHA_LOGIN_MAX=5
# USER_SERVICE_CAPTCHA_VERIFY_EMAIL_WINDOW=5m
# USER_SERVICE_CAPTCHA_VERIFY_EMAIL_MAX=5
# USER_SERVICE_CAPTCHA_VERIFY_PHONE_WINDOW=5m
# USER_SERVICE_CAPTCHA_VERIFY_PHONE_MAX=5
# USER_SERVICE_CAPTCHA_PASSWORD_RESET_WINDOW=5m
# USER_SERVICE_CAPTCHA_PASSWORD_RESET_MAX=5
# USER_SERVICE_CAPTCHA_BIND_WINDOW=5m
# USER_SERVICE_CAPTCHA_BIND_MAX=5

# -----------------------------------------------------------------------------
# Third-party — gid-service (snowflake ID generator)
# GID_MODE: module = in-process; grpc = remote gid-service.
# -----------------------------------------------------------------------------
USER_SERVICE_GID_MODE=module
# Only used when GID_MODE=grpc:
USER_SERVICE_GID_TARGET=
# module-mode snowflake config
USER_SERVICE_GID_MACHINE_ID=1
# snowflake epoch — DO NOT change after deployment
USER_SERVICE_GID_START_TIME=2024-01-01T00:00:00Z

# -----------------------------------------------------------------------------
# Third-party — message-service
# MESSAGE_MODE: module = in-process; grpc = remote message-service.
# -----------------------------------------------------------------------------
USER_SERVICE_MESSAGE_MODE=grpc
USER_SERVICE_MESSAGE_TARGET=localhost:9001

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
USER_SERVICE_LOG_LEVEL=info
USER_SERVICE_LOG_FORMAT=json
